<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="به منو اضافه کن"
        android:textColor="#1A2233"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="اسم (مثلا: شطرنج)"
        android:textColorHint="#A0A8B8"
        android:textColor="#1A2233"
        android:background="@drawable/bg_dialog_input"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:maxLines="1"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_emoji"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="ایموجی (مثلا: ♟️)"
        android:textColorHint="#A0A8B8"
        android:textColor="#1A2233"
        android:background="@drawable/bg_dialog_input"
        android:layout_marginTop="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:maxLines="1"
        android:maxLength="4"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_desc"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="توضیح (اختیاری)"
        android:textColorHint="#A0A8B8"
        android:textColor="#1A2233"
        android:background="@drawable/bg_dialog_input"
        android:layout_marginTop="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:maxLines="1"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/chip_game"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginEnd="5dp"
            android:text="🎮 بازی‌ها"
            android:textColor="#1A2233"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_prog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginStart="5dp"
            android:text="📱 برنامه‌ها"
            android:textColor="#1A2233"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_pick"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:text="📁 انتخاب فایل HTML"
        android:textColor="#6D5DF6"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="هنوز فایلی انتخاب نشده"
        android:textColor="#A0A8B8"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />
</LinearLayout>
